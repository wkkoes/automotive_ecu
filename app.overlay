#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    leds {
        compatible = "gpio-leds";
        
        lights_led: led_0 {
            gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
            label = "Lights_LED";
        };

        warning_led: led_1 {
            gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
            label = "Distance_Warning_LED";
        };
    };

    buttons {
        compatible = "gpio-keys";
        steering_button: button_0 {
            gpios = <&gpioc 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Steering wheel button";
        };
    }; 

    zephyr,user {

        trigger-gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>;
        echo-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;

        buzzer-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
    };
}; 

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;


    temp_press_sensor: bmp280@77 {
        compatible = "bosch,bme280";
        reg  = <0x77>; 
    };

    bmi160: bmi160@68 {
        compatible = "bosch,bmi160";
        reg = <0x68>;
    };   
 };
